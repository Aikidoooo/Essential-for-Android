<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/essential_icon"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@drawable/essential_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Essential">
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".LauncherActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:noHistory="true" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".update.UpdateInstallActivity" android:exported="false"
            android:launchMode="singleTop" />
        <activity-alias android:name=".LightLauncher" android:targetActivity=".LauncherActivity"
            android:enabled="true" android:exported="true" android:icon="@drawable/essential_icon"
            android:roundIcon="@drawable/essential_icon" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".DarkLauncher" android:targetActivity=".LauncherActivity"
            android:enabled="false" android:exported="true" android:icon="@drawable/essential_icon_dark"
            android:roundIcon="@drawable/essential_icon_dark" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".feature.qr.QrScannerTileService"
            android:exported="true"
            android:icon="@drawable/ic_qr_tile"
            android:label="@string/qr_scanner_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
    </application>

</manifest>
