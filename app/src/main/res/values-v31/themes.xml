<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Essential" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!-- Composeの初回描画前も白い既定背景を表示しない。 -->
        <item name="android:windowBackground">#100B23</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowSplashScreenBackground">#100B23</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/essential_icon</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
